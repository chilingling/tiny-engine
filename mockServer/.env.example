# OpenAI API 配置
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# 如果使用其他兼容 OpenAI API 的大模型，可以修改以上配置
# 例如使用国内的智谱 AI
# OPENAI_API_KEY=your_zhipu_api_key
# OPENAI_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4

# 或者使用百度文心一言
# OPENAI_API_KEY=your_baidu_api_key
# OPENAI_API_BASE_URL=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop/chat
# OPENAI_MODEL=ernie-bot-4

# MCP 配置
# 是否启用 MCP 功能
ENABLE_MCP=true
# MCP 服务器脚本路径
MCP_SERVER_SCRIPT_PATH=path/to/your/mcp/server.py
